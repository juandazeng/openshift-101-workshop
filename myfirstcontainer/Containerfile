FROM registry.access.redhat.com/ubi9/ubi
USER root

# Remove the protected Red Hat repo file and the plugin itself
RUN rm -f /etc/yum.repos.d/redhat.repo && \
    dnf --disableplugin=subscription-manager remove -y dnf-plugin-subscription-manager subscription-manager

# Install process utilities and httpd
RUN dnf install -y procps-ng httpd && \
    dnf clean all

# Configure httpd to listen on 8080, log to stdout/stderr, and allow GID 0 access
RUN sed -i 's/Listen 80/Listen 8080/' /etc/httpd/conf/httpd.conf && \
    sed -i 's/#ServerName www.example.com:80/ServerName localhost:8080/' /etc/httpd/conf/httpd.conf && \
    sed -i 's|ErrorLog "logs/error_log"|ErrorLog /dev/stderr|' /etc/httpd/conf/httpd.conf && \
    sed -i 's|CustomLog "logs/access_log" combined|CustomLog /dev/stdout combined|' /etc/httpd/conf/httpd.conf && \
    chgrp -R 0 /var/run/httpd /var/log/httpd /etc/httpd && \
    chmod -R g=u /var/run/httpd /var/log/httpd /etc/httpd

EXPOSE 8080

# Run as non-root user so behavior matches OpenShift locally
USER 1001

# Launch
ENTRYPOINT ["/usr/sbin/httpd", "-DFOREGROUND"]